# ClipForge Environment Variables
# Copy this file to .env and fill in your values

# AI/Transcript
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube OAuth
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=https://your-app.onrender.com/auth/youtube/callback
YOUTUBE_TOKEN=optional_existing_token

# TikTok OAuth
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://your-app.onrender.com/auth/tiktok/callback
TIKTOK_ACCESS_TOKEN=optional_existing_token

# Instagram OAuth
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=https://your-app.onrender.com/auth/instagram/callback
INSTAGRAM_ACCESS_TOKEN=optional_existing_token
INSTAGRAM_USER_ID=optional_instagram_user_id

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# App
JWT_SECRET=your_jwt_secret_here_change_in_production
BASE_URL=https://your-app.onrender.com
PORT=10000
NODE_ENV=production

# Storage (optional - defaults to local filesystem)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Security
ENCRYPTION_KEY=your_encryption_key_here

# Optional: Redis for job queue
REDIS_URL=redis://localhost:6379
